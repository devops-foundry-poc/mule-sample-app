<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>427b3435-71d5-43d2-95a8-5c2a683d97a8</groupId>
    <artifactId>mule-shared-assets-pom</artifactId>
    <version>1.0.4</version>
  </parent>

  <!--
    groupId = target Anypoint BG UUID for Exchange publishing.
    The CH2 deployment lookup uses this groupId to find the asset in Exchange.
    Deploy-time overridden per region via -Dproject.groupId or by using a
    separate Maven invocation per region (see deploy.yml).

    For the primary (EMEA) publish, this is the EMEA BG ID.
    The deploy.yml workflow overrides groupId per region when publishing.
  -->
  <groupId>57c5735b-b5cd-474c-b978-c9bdb69fb472</groupId>
  <artifactId>mule-sample-app</artifactId>
  <version>1.5.0-SNAPSHOT</version>
  <packaging>mule-application</packaging>
  <name>Mule Sample App</name>
  <description>
    Minimal Mule 4 application used to validate the CI/CD pipeline end-to-end:
    PR validate → Exchange publish (per region) → CloudHub 2.0 deploy.
  </description>

  <properties>
    <!--
      Exchange organisation to publish to. Overridden per region in the
      deploy workflow via -DexchangeGroupId=<bg-uuid>.
      Parent POM distributionManagement uses ${exchangeGroupId}/maven.
    -->
    <exchangeGroupId>${project.groupId}</exchangeGroupId>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.mule.connectors</groupId>
      <artifactId>mule-http-connector</artifactId>
      <classifier>mule-plugin</classifier>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.mule.tools.maven</groupId>
        <artifactId>mule-maven-plugin</artifactId>
        <extensions>true</extensions>
      </plugin>
    </plugins>
  </build>

  <repositories>
    <repository>
      <id>github</id>
      <name>GitHub Packages — mule-shared-assets</name>
      <url>https://maven.pkg.github.com/devops-foundry-poc/mule-shared-assets</url>
    </repository>
  </repositories>

</project>
